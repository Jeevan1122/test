# OpenAI API Key (required for Rasa actions)
OPENAI_API_KEY=your_openai_api_key_here

# AWS S3 Configuration (required for scan results storage)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Database Configuration
POSTGRES_USER=rasa_user
POSTGRES_PASSWORD=rasa_123
POSTGRES_DB=rasa_db
DB_URL=postgres://rasa_user:rasa_123@db:5432/rasa_db

# Node.js Environment
NODE_ENV=production

# Port Configuration (for development override)
FRONTEND_PORT=3000
BACKEND_PORT=3001
RASA_PORT=5005
RASA_ACTIONS_PORT=5055
POSTGRES_PORT=5432
